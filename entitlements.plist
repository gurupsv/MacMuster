<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Start at Login (SMAppService) requires this entitlement -->
	<key>com.apple.security.device.user-data</key>
	<true/>

	<!-- Accessibility permissions — the app monitors keyboard events and reads mouse location for overlay window behavior -->
	<key>com.apple.security.accessibility</key>
	<true/>

	<!-- No network access needed — pure local menu-bar app -->
	<!-- No file system access beyond standard user domain (defaults, caches) --></dict>
</plist>